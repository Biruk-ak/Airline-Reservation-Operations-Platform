# =============================================================================
# Airline Reservation & Operations Platform — .gitignore
# Covers React (frontend), Laravel/PHP (backend), secrets, OS, and IDE files.
# =============================================================================

# -----------------------------------------------------------------------------
# Dependencies
# -----------------------------------------------------------------------------
node_modules/
jspm_packages/
bower_components/
vendor/
.pnp/
.pnp.js
.yarn/
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# -----------------------------------------------------------------------------
# Environment & secrets (never commit real credentials)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env*.example
*.pem
*.p12
*.key
*.crt
*.cer
id_rsa
id_rsa.pub
*.keystore
secrets/
credentials.json
service-account*.json
auth.json
.npmrc
.yarnrc

# -----------------------------------------------------------------------------
# Laravel / PHP backend
# -----------------------------------------------------------------------------
backend/bootstrap/cache/*.php
!backend/bootstrap/cache/.gitignore
backend/storage/*.key
backend/storage/app/*
!backend/storage/app/.gitignore
!backend/storage/app/public/
backend/storage/app/public/*
!backend/storage/app/public/.gitignore
backend/storage/framework/cache/*
!backend/storage/framework/cache/.gitignore
backend/storage/framework/cache/data/*
!backend/storage/framework/cache/data/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/testing/*
!backend/storage/framework/testing/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/storage/logs/*
!backend/storage/logs/.gitignore
backend/public/hot
backend/public/storage
backend/public/build
.phpunit.result.cache
.phpunit.cache/
.php_cs.cache
.php-cs-fixer.cache
psalm.xml
psalm.xml.dist
phpstan.neon
phpstan.neon.dist
.phpactor.json
Homestead.json
Homestead.yaml
auth.json
/backend/.phpunit.cache

# -----------------------------------------------------------------------------
# React / frontend build & tooling
# -----------------------------------------------------------------------------
frontend/build/
frontend/dist/
frontend/.cache/
frontend/.parcel-cache/
frontend/.eslintcache
frontend/.stylelintcache
frontend/coverage/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
build/
dist/
out/
.turbo/
.next/
.nuxt/
.svelte-kit/
.vite/
*.tsbuildinfo

# -----------------------------------------------------------------------------
# Logs & debug
# -----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
composer-debug.log
php_errors.log

# -----------------------------------------------------------------------------
# Test / coverage
# -----------------------------------------------------------------------------
coverage/
.nyc_output/
htmlcov/
.coverage
*.lcov
clover.xml
junit.xml
test-results/
playwright-report/
cypress/videos/
cypress/screenshots/

# -----------------------------------------------------------------------------
# Caches
# -----------------------------------------------------------------------------
*.cache
.cache/
.sass-cache/
.tmp/
temp/
tmp/

# -----------------------------------------------------------------------------
# OS files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Editors / IDEs
# -----------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.sublime-project
*.sublime-workspace
*.code-workspace
.project
.classpath
.settings/
*.iml
nbproject/

# -----------------------------------------------------------------------------
# Local tooling / agents / misc
# -----------------------------------------------------------------------------
.history/
.cursor/
.claude/
.codex/
*.local
*.bak
*.orig
*.old
dump.rdb
*.sqlite
*.sqlite3
*.db
docker-compose.override.yml
.vagrant/
Vagrantfile.local

# -----------------------------------------------------------------------------
# Package manager locks (keep package-lock / composer.lock tracked when present)
# Uncomment only if your team prefers not to commit locks:
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
# composer.lock
# -----------------------------------------------------------------------------
